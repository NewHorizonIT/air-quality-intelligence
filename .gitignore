# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Environment variables
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Data — large files, never commit
data/raw/*
data/cleaned/*
data/external/*
data/features/*
data/exports/*
data/predictions/*

# Exceptions — keep folder placeholders
!data/raw/.gitkeep
!data/cleaned/.gitkeep
!data/external/.gitkeep
!data/features/.gitkeep
!data/exports/.gitkeep
!data/predictions/.gitkeep

# Cache — small JSON, intentionally tracked
# data/.cache/ → tracked

# Trained models — can be hundreds of MB
models/*
!models/.gitkeep

# Figures — regenerated from scripts
reports/figures/*
!reports/figures/.gitkeep

# Logs
*.log

# Python packaging
.pytest_cache/
.mypy_cache/
.ruff_cache/
